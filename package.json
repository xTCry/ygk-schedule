{
  "name": "ygk-schedule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:pages": "tsc -p tsconfig.pages.json",
    "test": "vitest run",
    "update": "tsx src/cli/update.ts",
    "regenerate-artifacts": "tsx src/cli/regenerate-artifacts.ts",
    "generate-ical": "tsx src/cli/generate-ical.ts",
    "download-replacements": "tsx src/cli/download-replacements.ts",
    "update-replacements": "tsx src/cli/update-replacements.ts",
    "publication-status": "tsx src/cli/write-publication-status.ts",
    "sync-issues": "tsx src/cli/sync-issues.ts",
    "workflow:check": "tsx src/cli/check-parser-workflow.ts",
    "workflow:update-schedule": "tsx src/cli/update-schedule-workflow.ts",
    "workflow:update-replacements": "tsx src/cli/update-replacements-workflow.ts",
    "workflow:publish": "tsx src/cli/publish-data.ts",
    "workflow:summary": "tsx src/cli/write-workflow-summary.ts",
    "pages:build": "tsx src/cli/build-pages.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run typecheck:pages && npm run lint && npm run test && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
